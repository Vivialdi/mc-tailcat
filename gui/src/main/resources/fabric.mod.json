{
  "schemaVersion": 1,
  "id": "${mod_id}_gui",
  "version": "${version}",
  "name": "Tailcat GUI",
  "description": "Adds an 'Add Tailcat Server' button to the multiplayer screen, so a player can paste an address instead of editing a config file. Optional, and tied to one Minecraft version -- the main Tailcat mod stays version-independent without it.",
  "authors": [
    "vivialdi"
  ],
  "contact": {
    "homepage": "https://github.com/vivialdi/mc-tailcat",
    "sources": "https://github.com/vivialdi/mc-tailcat",
    "issues": "https://github.com/vivialdi/mc-tailcat/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.vivialdi.mctailcat.gui.TailcatGuiEntrypoint"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "java": ">=21",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "${mod_id}": ">=1.1.0"
  }
}
